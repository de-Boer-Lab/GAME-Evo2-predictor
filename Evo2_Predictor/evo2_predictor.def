Bootstrap: localimage
From: ./evo2/evo2.sif

%files
    ./config.py /opt/evo2-predictor/config.py
    ./predictor_RestAPI.py /opt/evo2-predictor/predictor_RestAPI.py
    ./evo2_utils.py /opt/evo2-predictor/evo2_utils.py
    ./error_checking_functions.py /opt/evo2-predictor/error_checking_functions.py
    ./predictor_content_handler.py /opt/evo2-predictor/predictor_content_handler.py
    ./predictor_help_message.json /opt/evo2-predictor/predictor_help_message.json
    ./schema_validation.py /opt/evo2-predictor/schema_validation.py
    
    # Copy the modified package, leaving behind large files (sif, notebooks, etc)
    ./evo2/evo2 /opt/evo2-predictor/evo2/evo2
    ./evo2/pyproject.toml /opt/evo2-predictor/evo2/pyproject.toml
    ./evo2/README.md /opt/evo2-predictor/evo2/README.md
    ./evo2/LICENSE /opt/evo2-predictor/evo2/LICENSE

    # Copy the single raw PyTorch weights file
    ./weights/evo2_7b.pt /opt/evo2-predictor/weights/evo2_7b.pt

%environment
    export APPTAINER_NO_MOUNT="home,tmp,proc,sys,dev"
    export LC_ALL=C
    export TRITON_CACHE_DIR=/tmp/triton_cache
    export XDG_CACHE_HOME=/tmp/xdg_cache

    export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
    
    # Point Evo 2 directly to the baked weights file
    export EVO2_WEIGHTS=/opt/evo2-predictor/weights/evo2_7b.pt
   
%post
    # Fail the build instantly if any command fails
    set -e

    echo "Installing API dependencies..."
    python3 -m pip install --no-cache-dir flask msgpack

    # Install the modified evo2 package over the base image version.
    echo "Installing modified Evo 2 package..."
    python3 -m pip install -e /opt/evo2-predictor/evo2 --no-deps --force-reinstall
    
    echo "Setting permissions..."
    chmod -R 755 /opt/evo2-predictor/

    # Verification: Ensure the track function imports successfully against base dependencies
    echo "Running verification checks..."
    python3 -c "import evo2, torch; from evo2.scoring import score_sequences_track; print('Evo 2 + track import OK')"
    test -s /opt/evo2-predictor/weights/evo2_7b.pt && echo "Evo 2 Weights Verified"

